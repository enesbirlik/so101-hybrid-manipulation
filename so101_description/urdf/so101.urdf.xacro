<?xml version="1.0"?>
<!-- Entry point: the vendored SO-101 arm, optionally with the wrist camera, the table and ros2_control. -->
<robot name="so101" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="use_wrist_camera" default="true"/>
  <xacro:arg name="kinematics" default="$(find so101_description)/config/so101_kinematics.yaml"/>
  <xacro:arg name="table" default="true"/>
  <xacro:arg name="ros2_control" default="false"/>
  <xacro:arg name="use_mock_hardware" default="true"/>

  <!-- Calibrated joint origins (tools/so101_hand_eye.py kinematics), used by so101_new_calib.urdf. -->
  <xacro:property name="kinematics_file" value="${xacro.load_yaml('$(arg kinematics)')}"/>
  <xacro:property name="kinematics" value="${kinematics_file['joints']}"/>
  <xacro:macro name="calibrated_origin" params="joint">
    <xacro:property name="o" value="${kinematics[joint]}"/>
    <origin xyz="${o['xyz'][0]} ${o['xyz'][1]} ${o['xyz'][2]}" rpy="${o['rpy'][0]} ${o['rpy'][1]} ${o['rpy'][2]}"/>
  </xacro:macro>

  <xacro:include filename="$(find so101_description)/urdf/so101_new_calib.urdf"/>

  <xacro:if value="$(arg use_wrist_camera)">
    <xacro:include filename="$(find so101_description)/urdf/wrist_camera.xacro"/>
    <xacro:so101_wrist_camera parent="gripper_link"/>
  </xacro:if>

  <!-- The table the base stands on, as a collision object for planning. Its top is at the
       measured table_z; without one, at the bottom of the base meshes. -->
  <xacro:if value="$(arg table)">
    <xacro:property name="table_top" value="${kinematics_file.get('table_z', -0.0024)}"/>
    <link name="table">
      <visual>
        <origin xyz="0.2 0 -0.01"/>
        <geometry><box size="0.8 0.8 0.02"/></geometry>
        <material name="table_wood"><color rgba="0.55 0.45 0.35 0.6"/></material>
      </visual>
      <collision>
        <origin xyz="0.2 0 -0.01"/>
        <geometry><box size="0.8 0.8 0.02"/></geometry>
      </collision>
    </link>
    <joint name="table_joint" type="fixed">
      <parent link="base_link"/>
      <child link="table"/>
      <origin xyz="0 0 ${table_top}"/>
    </joint>
  </xacro:if>

  <xacro:if value="$(arg ros2_control)">
    <xacro:include filename="$(find so101_description)/urdf/so101.ros2_control.xacro"/>
    <xacro:so101_ros2_control name="so101" use_mock_hardware="$(arg use_mock_hardware)"/>
  </xacro:if>
</robot>
