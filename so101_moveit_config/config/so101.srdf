<?xml version="1.0" encoding="UTF-8"?>
<!-- Semantic description of the SO-101. -->
<robot name="so101">
  <group name="arm">
    <chain base_link="base_link" tip_link="gripper_frame_link"/>
  </group>
  <group name="gripper">
    <joint name="gripper"/>
  </group>

  <!-- zero: the calibration pose, arm stretched forward. rest: folded on its stops. -->
  <group_state name="zero" group="arm">
    <joint name="shoulder_pan" value="0"/>
    <joint name="shoulder_lift" value="0"/>
    <joint name="elbow_flex" value="0"/>
    <joint name="wrist_flex" value="0"/>
    <joint name="wrist_roll" value="0"/>
  </group_state>
  <group_state name="rest" group="arm">
    <joint name="shoulder_pan" value="0"/>
    <joint name="shoulder_lift" value="-1.62"/>
    <joint name="elbow_flex" value="1.54"/>
    <joint name="wrist_flex" value="0"/>
    <joint name="wrist_roll" value="0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="gripper" value="0.8"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="gripper" value="-0.1"/>
  </group_state>

  <end_effector name="gripper" parent_link="gripper_link" group="gripper" parent_group="arm"/>

  <!-- Adjacent links, and pairs near the base that 20000 random poses never brought into contact
       (collisions_updater). Other "never" pairs stay checked: in the hand-eye runs the camera did
       brush the arm, so sampling within the URDF limits is not proof. -->
  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="table" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="table" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="lower_arm_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="lower_arm_link" link2="wrist_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="wrist_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="moving_jaw_so101_v1_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="wrist_camera_mount_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="wrist_camera_link" reason="Never"/>
  <disable_collisions link1="wrist_camera_link" link2="wrist_camera_mount_link" reason="Adjacent"/>
</robot>
